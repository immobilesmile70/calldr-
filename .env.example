# =============================================================================
# CLIENT — Expo public env vars (exposed to client bundle)
# =============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCcwww5cbNy6ig7TnBltVqfHtLp2h57r6s
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=calldr.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=calldr
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=calldr.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=81815584283
EXPO_PUBLIC_FIREBASE_APP_ID=1:81815584283:web:656f520587221883c102be
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-0R40K0X5KH
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://calldr-default-rtdb.firebaseio.com

# Vercel API base URL (native only — web uses relative /api)
EXPO_PUBLIC_API_URL=https://your-project.vercel.app

# Google Sign-In web client ID (same as server GOOGLE_WEB_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# =============================================================================
# SERVER — Vercel serverless functions only (never exposed to client)
# =============================================================================

# Firebase Admin SDK — provide EITHER the full JSON as one line OR individual fields
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"calldr",...}
# OR split fields:
# FIREBASE_PROJECT_ID=calldr
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@calldr.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

FIREBASE_DATABASE_URL=https://calldr-default-rtdb.firebaseio.com
FIREBASE_WEB_API_KEY=AIzaSyCcwww5cbNy6ig7TnBltVqfHtLp2h57r6s

# Google OAuth (for /api/auth/google)
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# =============================================================================
# TURN server (required for reliable calls on cellular / strict NATs)
# =============================================================================
# Provide comma-separated URLs for multiple TURN servers
TURN_URLS=turn:your-turn-server.example.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential
