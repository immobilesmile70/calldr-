rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ────────────────────────────────────────────────────────
    // Read: owner only
    // Write: owner may only update fcmTokens; no create or delete by client
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Client may only update fcmTokens (array union / array remove via backend)
      // All other fields are managed server-side
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['fcmTokens']);

      // No client create or delete
      allow create, delete: if false;
    }

    // ── codes/{code} ──────────────────────────────────────────────────────
    // No client access — server-only (Admin SDK)
    match /codes/{code} {
      allow read, write: if false;
    }

    // ── connections/{connectionId} ────────────────────────────────────────
    // Read: either member
    // Write: server-only (Admin SDK)
    match /connections/{connectionId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      allow write: if false;
    }
  }
}
